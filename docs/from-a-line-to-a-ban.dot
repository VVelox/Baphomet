digraph from_a_line_to_a_ban {
	rankdir = TB;
	node [shape = box, style = rounded, fontname = "Helvetica", fontsize = 11];
	edge [fontname = "Helvetica", fontsize = 10];

	line [label = "a new line on a watched log"];
	parse [label = "the watcher's parser\nsplits it into a record"];
	skip [label = "counted and skipped"];
	field [label = "the watcher's indexed field is read off\nthe record... the daemon for syslog, the\nmost selective gate field for the rest,\nor nothing when the rules pin nothing"];
	lookup [label = "the value of that field is then looked up in\nthe watcher's rule index, which maps each value\nto the rules that could match a record carrying it"];
	cands [label = "the candidate list, config order kept...\nthe rules whose gate takes the value, the\nrules pinning nothing on the field, and the\nrules the index can not hold to a gate...\na capture, ignore, key, or track, or no\nplain equality left to key on"];
	next [label = "a candidate\nleft?", shape = diamond];
	done [label = "the line is done"];
	type [label = "the rule's\ntype?", shape = diamond];
	tsyslog [label = "a syslog rule opens with its daemons list...\nthe line's daemon must be one the rule names"];
	thttp [label = "a http rule opens with its\nstatus and method gates"];
	thttperr [label = "a http_error rule opens with\nits level and module gates"];
	ign [label = "ignore / ignore_regexp"];
	capt [label = "capture entries store context,\nor complete a deferred offense"];
	match [label = "the match... message_regexp or match\nentries in order, first hit wins;\na staged rule advances its sequence instead;\nwith no matcher the boolean alone judges"];
	bool [label = "the boolean... gate, keywords, or\nselections, over captures, munger\nfields, and JSON fields alike"];
	sweep [label = "the track sweep...\neach declared record takes this line's\ncontribution, offense or not"];
	fired [label = "an offense?", shape = diamond];
	gates [label = "the gates on named vars...\nmarked, country, namtar_list,\nreverse_dns, active_time"];
	nofire [label = "the rule did not fire...\nnothing counted, nothing consumed"];
	cand [label = "the offenders... each ban_var read out\nof the offense, ban_not_internal dropping\nyour own hosts"];
	scrub [label = "usedns settles hostnames... one address\nunder two names, or two names resolving\nto one address, counting once"];
	ogates [label = "the same gates less active_time,\nkeyed by the offender"];
	brand [label = "mark and unmark\nbrand the survivors"];
	igip [label = "ignore_ips"];
	count [label = "the hit is deposited... weight into the\noffender's bucket, hits older than\nfind_time fall out; the subnet tally\ntakes the same deposit"];
	ban [label = "banishment... the ban sent to the\nEreshkigal manager for ban_time, the\nbucket cleared; a subnet that crossed\ngoes as a whole CIDR"];
	queue [label = "queued in the tablets,\nretried every ten seconds"];
	consume [label = "the watcher's\noverlap", shape = diamond];
	shadow [label = "later rules run demoted\ninto the shadow buckets"];

	line -> parse;
	parse -> skip [label = "does not parse"];
	parse -> field;
	field -> lookup;
	lookup -> cands;
	cands -> next;
	next -> done [label = "no"];
	next -> type [label = "yes"];
	type -> tsyslog [label = "syslog"];
	type -> thttp [label = "http"];
	type -> thttperr [label = "http_error"];
	type -> ign [label = "json / raw...\nno type gate"];
	tsyslog -> next [label = "refused"];
	thttp -> next [label = "refused"];
	thttperr -> next [label = "refused"];
	tsyslog -> ign;
	thttp -> ign;
	thttperr -> ign;
	ign -> next [label = "hit... nothing stored,\nnothing harvested"];
	ign -> capt;
	capt -> match;
	match -> sweep [label = "no hit"];
	match -> bool [label = "hit"];
	bool -> sweep;
	sweep -> fired;
	fired -> next [label = "no"];
	fired -> gates [label = "yes"];
	gates -> nofire [label = "any vetoes"];
	nofire -> next;
	gates -> cand;
	cand -> scrub;
	scrub -> ogates;
	ogates -> nofire [label = "no offender survives"];
	ogates -> brand;
	brand -> next [label = "mark_only / track_only...\nthe line is not consumed"];
	brand -> igip;
	igip -> next [label = "listed... not counted"];
	igip -> count;
	count -> consume [label = "score short of max_score...\na found event to EVE"];
	count -> ban [label = "max_score reached"];
	ban -> queue [label = "unreachable"];
	queue -> consume;
	ban -> consume;
	consume -> done [label = "first"];
	consume -> shadow [label = "shadow"];
	shadow -> next;
	consume -> next [label = "all"];
}
